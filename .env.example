# --- storage backend ---
# sqlite = fully offline default (tests + demo). postgres = live pgvector.
SUPPORT_BACKEND=sqlite
# Path for the SQLite file (created automatically; parent dirs too).
SUPPORT_DB_PATH=data/support.db
# Postgres DSN for the live backend. With docker-compose.yml below:
#   DATABASE_URL=postgresql://support:support@localhost:5433/support_agent
DATABASE_URL=

# --- retrieval / answering ---
# How many chunks feed each answer.
SUPPORT_TOP_K=3
# Min top-hit score to auto-answer; below this a ticket is opened instead.
SUPPORT_THRESHOLD=0.12
# chunking: max chars per chunk + overlap carried into the next chunk.
SUPPORT_CHUNK_MAX_CHARS=1200
SUPPORT_CHUNK_OVERLAP=150

# --- embeddings ---
# hash = offline deterministic fake (default). openai = live embeddings.
SUPPORT_EMBEDDER=hash
SUPPORT_EMBEDDING_DIM=512

# --- optional live LLM rephrasing (offline extractive composer is default) ---
# LLM_PROVIDER=openai enables rewording via a chat-completions endpoint.
LLM_PROVIDER=
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# --- telegram transport (optional) ---
# Leave TELEGRAM_BOT_TOKEN empty to use the offline FakeTransport.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- tickets ---
# Default contact stored on tickets when the asker gives none.
SUPPORT_CONTACT=
